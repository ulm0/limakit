# Options limakit enables on top of LinuxKit's kernel config (kernel/build.sh applies them, then
# runs olddefconfig). Built in (=y), not modules: nothing in the image loads modules at boot.

# Lima mounts: mountType virtiofs (vz)
CONFIG_VIRTIO_FS=y
# lima-guestagent <-> hostagent channel
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y
# limactl stop: VZ signals the power button through its PL061 GPIO controller (ACPI ARMH0061)
CONFIG_GPIO_PL061=y
CONFIG_KEYBOARD_GPIO=y
# VZ USB keyboard/digitizer present before acpid scans /dev/input
CONFIG_USB_XHCI_HCD=y
# additionalDisks fsType: btrfs
CONFIG_BTRFS_FS=y
# audio.device (vz virtio-sound)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y
# video.display (vz virtio-gpu, console on tty0)
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
# Kubernetes templates (k3s/k8s): pressure stall info, nftables kube-proxy
CONFIG_PSI=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_NUMGEN=y
