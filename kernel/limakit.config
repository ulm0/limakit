# Complete limakit kernel fragment over 'make ARCH=arm64 allnoconfig' (then scripts/config --set-val each line, then olddefconfig). Not a delta on LinuxKit's config.
# Anything unlisted is allnoconfig's n, or the Kconfig default if it only becomes visible here. A '# uncertain:' line flags the option below it; it is not a trailing comment because build.sh would read that into the value.

# LinuxKit kernel Dockerfile: modules_install + Module.symvers need MODULES; keep uname -r / lib/modules path
CONFIG_MODULES=y
CONFIG_LOCALVERSION="-linuxkit"

# VZLinuxBootLoader direct boot: DT only, no EFI/ACPI (EFI=n also keeps EFI_ZBOOT off, so the build produces Image.gz)
CONFIG_EFI=n
CONFIG_ACPI=n

# core userspace basics (most are on anyway while EXPERT=n; listed so a dropped one fails the build check)
CONFIG_EXPERT=n
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_CROSS_MEMORY_ATTACH=n
CONFIG_CHECKPOINT_RESTORE=n

# exec: ELF, #! scripts, binfmt_misc (Rosetta)
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=y

# timers: hrtimers for nanosleep/timerfd; tickless idle so an idle VM stops waking the host
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y

# arm64 CPU features allnoconfig drops (hardening/perf on M4)
# uncertain: hardening only, not needed to boot
CONFIG_ARM64_PAN=y
# uncertain: performance only (LL/SC fallback works)
CONFIG_ARM64_USE_LSE_ATOMICS=y

# PCI: every VZ virtio device + ECAM host bridge, MSI-X via GICv2m
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_HOST_GENERIC=y

# virtio over PCI (modern only)
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=n
# uncertain: VZ balloon present; free page reporting gives memory back to macOS, boots without it
CONFIG_VIRTIO_BALLOON=y

# disks: vda squashfs root, vdb data, cidata, additionalDisks (discard is a virtio-blk feature)
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
# data lives on /dev/loop0, a window onto /dev/vda after the squashfs root mounted from the same disk
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_WRITE_MOUNTED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# consoles: hvc0 (virtio-console), ptys for sshd/docker -t, tty0/tty1 via dummycon
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_VIRTIO_CONSOLE=y

# rngd: virtio-rng
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# clock: PL031 RTC, set system time at boot, /dev/rtc0 for hwclock and Lima's RTC check
CONFIG_RTC_CLASS=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y

# limactl stop: VZ power button = PL061 GPIO -> gpio-keys -> evdev -> acpid
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_ATKBD=n
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y

# no USB: the xhci keyboard/digitizer only matters for video.display
# uncertain: add USB_SUPPORT/USB/USB_XHCI_HCD/HID_SUPPORT/HID_GENERIC/USB_HID if display keyboard input is wanted
CONFIG_USB_SUPPORT=n

# pseudo filesystems: /proc, sysctl, /sys, devtmpfs (mounted by the kernel: squashfs root, no initramfs), tmpfs
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=n
# uncertain: rc.init writes /proc/sys/kernel/hotplug, but devtmpfs + mdev -s cover device nodes
CONFIG_UEVENT_HELPER=n

# root filesystem: squashfs (gzip) is under the MISC_FILESYSTEMS menu
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
# LinuxKit's squashfs carries xattrs (file capabilities); without this they are silently dropped
CONFIG_SQUASHFS_XATTR=y

# data disk + additionalDisks: ext4 (default), xfs (v5 only), btrfs
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=y
CONFIG_XFS_SUPPORT_V4=n
CONFIG_XFS_SUPPORT_ASCII_CI=n
CONFIG_BTRFS_FS=y
# uncertain: only for additionalDisks fsType swap (and docker --memory-swap); no swap in the image
CONFIG_SWAP=y

# Lima cidata ISO (Rock Ridge only)
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=n
CONFIG_ZISOFS=n

# overlayfs: LinuxKit rw volumes, containerd snapshotter, docker overlay2
CONFIG_OVERLAY_FS=y

# virtiofs mounts + Rosetta share, reverse-sshfs (/dev/fuse)
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# THP: linuxkit/sysfs writes transparent_hugepage/* and log.Fatal's on a missing path
CONFIG_TRANSPARENT_HUGEPAGE=y

# namespaces: LinuxKit services, runc/docker
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# runc needs /proc/self/setgroups, which only exists with user namespaces (every service fails without it)
CONFIG_USER_NS=y
CONFIG_TIME_NS=n

# seccomp: docker default profile, runc, dhcpcd privsep
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# cgroup v2 controllers: cpu, cpuset, memory, pids, io (+io.max); devices via BPF (no v1 controllers)
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
# v1 controller symbols k3s' check-config requires (kubelet on cgroup v2 still probes them)
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y

# guestagent eBPF port ticker: tracepoint syscalls:sys_exit_bind via perf_event_open (tracefs from FTRACE_SYSCALLS; UPROBE_EVENTS satisfies BPF_EVENTS)
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
# uncertain: optional, the interpreter runs the ticker and runc device filter fine
CONFIG_BPF_JIT=y

# networking core: netlink/rtnetlink, AF_UNIX sockets, TCP/IP + IPv6, AF_PACKET (dhcpcd, docker ARP)
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_SYN_COOKIES=y
CONFIG_IPV6=y
CONFIG_IPV6_SIT=n
CONFIG_PACKET=y
CONFIG_WIRELESS=n

# guestagent port discovery: netlink sock_diag for TCP and UDP (UDP forwarding silently breaks without it)
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y

# NICs: eth0 + lima0 virtio-net; docker veth/bridge
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_VETH=y
CONFIG_TUN=n
CONFIG_ETHERNET=n
CONFIG_WLAN=n
CONFIG_BRIDGE=y
CONFIG_BRIDGE_IGMP_SNOOPING=n

# vsock: guestagent <-> hostagent, ssh over vsock (socat VSOCK-LISTEN)
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VSOCKETS_DIAG=n
CONFIG_VSOCKETS_LOOPBACK=n

# docker:28-dind runs iptables-nft (dockerd started directly, no legacy switch): nf_tables + xt compat for addrtype/conntrack/MASQUERADE/DNAT/SNAT
# NETFILTER_ADVANCED=y keeps the unlisted netfilter options n instead of their default m
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_NAT=y
# xt_addrtype (and other xt matches) register their IPv6 variant only with IP6_NF_IPTABLES, even under nft:
# without it dockerd can't set up its ip6tables chains
CONFIG_IP6_NF_IPTABLES=y

# nestedVirtualization: /dev/kvm in the guest (VHE), docker --device /dev/kvm
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y

# k3s / k3d (Kubernetes in docker): k3s contrib/util/check-config.sh's required list, plus what its defaults use:
# kube-proxy (iptables: MARK, REJECT, comment, multiport, statistic; iptables-nft may emit native ct/limit/reject),
# flannel (VXLAN), the network-policy controller (ipset, set match, limit, NFLOG)
# 6.18+: the legacy (non-nft) iptables tables are behind these
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_VXLAN=y
CONFIG_EXT4_FS_POSIX_ACL=y

# Cilium (docs.cilium.io system requirements): base (tc BPF, BTF, schedstats), tunnels (VXLAN above, GENEVE,
# FIB rules), iptables masquerading (ipset/comment above), L7/FQDN policies (TPROXY, socket/mark/CT),
# bandwidth manager (fq). BTF needs debug info + pahole at build time (kernel/build.sh).
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHEDSTATS=y
CONFIG_CRYPTO_SHA1=y
CONFIG_GENEVE=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
# Cilium's netlink library opens every family it knows; without the XFRM one the agent fails to start
# ('protocol not supported')
CONFIG_XFRM_USER=y
# Cilium's start-up requirements (pkg/datapath/linux/requirements.go): bpf_get_cgroup_classid()
CONFIG_CGROUP_NET_CLASSID=y
