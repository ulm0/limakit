# 'aws' flavor: limakit.config plus what EC2 Graviton (Nitro, arm64) needs to boot and run k3s (ulm0/yagan).
# kernel/build.sh 6.18.57 aws applies limakit.config, then these lines (a later line wins). Same format and
# '# uncertain:' convention as limakit.config.

# Graviton boots through UEFI (systemd-boot + a UKI, LinuxKit's raw-efi) and describes its hardware with ACPI.
# The UKI needs an uncompressed PE kernel (EFI_STUB, `linuxkit build --decompress-kernel`), not EFI_ZBOOT.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ZBOOT=n
CONFIG_ACPI=y
# kubelet reads /sys/class/dmi/id/product_uuid for the node's system UUID
CONFIG_DMI=y
CONFIG_DMIID=y

# the root filesystem is LinuxKit's gzip initramfs (raw-efi), not limakit's squashfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# interrupts: GICv3 with ITS for PCIe MSI-X (VZ uses GICv2 + GICv2m)
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y

# PCIe: Nitro attaches EBS volumes and ENIs at runtime by PCIe hotplug
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
# uncertain: hotplug may go through ACPI on Graviton rather than native pciehp
CONFIG_HOTPLUG_PCI_ACPI=y

# EBS and instance store volumes are NVMe
CONFIG_BLK_DEV_NVME=y

# ENA network interface (ETHERNET=n in limakit.config hides every vendor driver)
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=y

# serial console (EC2 console output / serial console). The UART comes from ACPI SPCR, so the kernel picks it
# without console=; 'earlycon' on the cmdline uses it from the first line.
# uncertain: Graviton's UART type (16550-compatible vs PL011); both are enabled
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# clock: the EFI runtime RTC instead of VZ's PL031
CONFIG_RTC_DRV_EFI=y

# instance stop/terminate: ACPI power button -> evdev -> acpid (same /etc/acpi/PWRF action as limakit)
# uncertain: whether Graviton signals it as an ACPI button or a GPIO key (PL061/KEYBOARD_GPIO stay on)
CONFIG_ACPI_BUTTON=y
