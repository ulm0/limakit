{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "the kernel: github.com/ulm0/lk-kernel, by version and digest",
      "managerFilePatterns": [
        "/^limakit\\.yml$/"
      ],
      "matchStrings": [
        "image: (?<depName>ghcr\\.io/ulm0/lk-kernel):(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "the kernel stays on its LTS series; a new series is a deliberate change",
      "matchDepNames": [
        "ghcr.io/ulm0/lk-kernel"
      ],
      "allowedVersions": "/^6\\.18\\./"
    }
  ]
}
